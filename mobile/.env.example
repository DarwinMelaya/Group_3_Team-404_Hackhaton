# Existing Supabase project: Agri. Copy to .env.local (ignored by Git) to enable LIVE SUPABASE MODE.
# When set, the mobile app connects to Supabase Agri Auth and public.harvest_listings (see src/lib/supabase-client.ts).
# Use ONLY the project URL and the PUBLISHABLE / anon key (sb_publishable_... or eyJ...).
# NEVER put a secret key (sb_secret_...), service_role key, database password,
# or AI API key in any EXPO_PUBLIC_ variable: they are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
