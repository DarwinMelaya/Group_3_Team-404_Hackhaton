# Existing Supabase project: Agri. Copy to .env.local (ignored by Git) to enable LIVE SUPABASE MODE.
# When set, the web portal connects to Supabase Agri Auth, public.harvest_listings, and review_harvest_listing RPC.
# Use ONLY the project URL and the PUBLISHABLE / anon key (sb_publishable_... or eyJ...).
# NEVER put a secret key (sb_secret_...), service_role key, database password,
# or AI API key in any NEXT_PUBLIC_ variable: they are inlined into browser JavaScript.
# Future server-only secrets (Phase 2C+) must use names WITHOUT the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
